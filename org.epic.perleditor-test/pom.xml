<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.epic</groupId>
        <artifactId>org.epic.parent</artifactId>
        <version>0.7.13-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>org.epic.perleditor_test</artifactId>
    <packaging>eclipse-test-plugin</packaging>

    <build>
        <plugins>
            <!-- 1. Copy the pre-configured test workspace to target/test-workspace -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-test-workspace</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/test-workspace</outputDirectory>
                            <!-- Ensure .project and hidden metadata files are copied -->
                            <addDefaultExcludes>false</addDefaultExcludes>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/workspace</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Point Tycho to the copied test workspace -->
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-surefire-plugin</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <useUIHarness>true</useUIHarness>
                    <useUIThread>true</useUIThread>
                    
                    <argLine>-Xms256m -Xmx2048m</argLine>
                    
                    <!-- Point Eclipse directly to the copied workspace -->
                    <appArgLine>-data "${project.build.directory}/test-workspace"</appArgLine>
                    
                    <dependencies>
                        <dependency>
                            <type>p2-installable-unit</type>
                            <artifactId>org.eclipse.platform.feature.group</artifactId>
                        </dependency>
                        <dependency>
                            <type>p2-installable-unit</type>
                            <artifactId>org.eclipse.rcp.feature.group</artifactId>
                        </dependency>
                    </dependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
