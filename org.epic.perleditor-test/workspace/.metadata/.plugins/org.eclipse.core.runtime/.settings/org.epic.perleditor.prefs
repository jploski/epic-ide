ENABLE_DEBUG_CONSOLE=true
PERL_EXECUTABLE="/usr/bin/perl"
SHOW_WARNINGS=0
SUSPEND_AT_FIRST_CONSOLE=false
SYNTAX_VALIDATION_IDLE_INTERVAL=2000
SYNTAX_VALIDATION_PREFERENCE=0
USE_TAINT_MODE=0
autoCompletionBracket1=false
autoCompletionBracket2=false
autoCompletionBracket3=false
autoCompletionBracket4=false
eclipse.preferences.version=1
showGlobalVars=true
